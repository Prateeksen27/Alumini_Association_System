<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <title>Alumni Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/style.min.css" rel="stylesheet" />
    <link href="/styles/index.css" rel="stylesheet" />
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f6f9;
            margin: 0;
            padding: 0;
        }

        .container {
            max-width: 1200px;
            margin: 2rem auto;
            padding: 2rem;
            background-color: #ffffff;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        h2 {
            color: #333;
            margin-bottom: 1.5rem;
            font-size: 1.8rem;
            font-weight: 600;
            text-align: center;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 1rem;
            color: #333;
            margin-top: 1rem;
        }

        table th,
        table td {
            padding: 1rem;
            border: 1px solid #ddd;
        }

        table th {
            background-color: #007bff;
            color: #ffffff;
            text-align: left;
            font-weight: 600;
        }

        table tr:nth-child(even) {
            background-color: #f1f1f1;
        }

        table tr:hover {
            background-color: #e9ecef;
        }

        .table-actions {
            display: flex;
            gap: 0.5rem;
        }

        .btn-response {
            background-color: #28a745;
            color: #ffffff;
            border: none;
            padding: 0.5rem 1rem;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 500;
            transition: background-color 0.3s, box-shadow 0.3s;
        }

        .btn-response:hover {
            background-color: #218838;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .btn-response:focus {
            outline: none;
            box-shadow: 0 0 0 2px rgba(40, 167, 69, 0.5);
        }
    </style>
</head>

<body class="sb-nav-fixed">
    <%- include('../partials/Alumniheader.ejs') %>
        <div id="layoutSidenav_content">
            <main>
                <div class="container-fluid px-4">
                    <div class="container">
                        <h2>Responces</h2>
                        <table>
                            <thead>
                                <tr>
                                    <th>Applicant Name</th>
                                    <th>Availablility</th>
                                    <th>Objective</th>
                                    <th>Resume</th>
                                    <th>Acept/Reject</th>
                                </tr>
                            </thead>
                            <tbody id="applicationsTable">
                                <% job.forEach(element=> { %>
                                    <tr>
                                        <td>
                                            <%= element.applicant_name %>
                                        </td>
                                        <td>
                                            <%= element.availability %>
                                        </td>
                                        <td onclick="showFullAnswer(`<%= element.answer.replace(/'/g, "\\'").replace(/"/g, '&quot;').replace(/\n/g, ' ') %>`)" 
                                            style="cursor: pointer; ">
                                            <% if (element.answer.length > 100) { %>
                                                <%= element.answer.substring(0, 20) %>...
                                            <% } else { %>
                                                <%= element.answer %>
                                            <% } %>
                                        </td>
                                        
                                        
                                        <td>
                                            <a style="text-decoration: none; color: black;"
                                                href="/resumes/<%= element.resume %>" target="_blank">View Resume</a>
                                        </td>
                                        <td class="p-3 border border-gray-300">
                                            <% if (element.status == 'Not evaluated') { %>
                                            <div class="flex space-x-2">
                                                <button style="background: green;" onclick="handleApplication('<%= element.application_id %>', '<%= element.job_id %>', 'accept')"
                                                    class="bg-green-500 text-white px-4 py-2 rounded hover:bg-green-700">
                                                    Accept
                                                </button>
                                                <button style="background: red;" onclick="handleApplication('<%= element.application_id %>', '<%= element.job_id %>', 'reject')"
                                                    class="bg-red-500 text-white px-4 py-2 rounded hover:bg-red-700">
                                                    Reject
                                                </button>
                                            </div>
                                            <% } else { %>
                                            <span class="text-gray-700 font-semibold"><%= element.status %></span>
                                            <% } %>
                                        </td>

                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </main>
            <footer class="py-4 bg-light mt-auto">
                <div class="container-fluid px-4">
                    <div class="d-flex align-items-center justify-content-between small">
                        <div class="text-muted">Copyright &copy; Your Website 2023</div>
                        <div>
                            <a href="#">Privacy Policy</a>
                            &middot;
                            <a href="#">Terms &amp; Conditions</a>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"
            crossorigin="anonymous">
            </script>
        <script src="/js/scripts.js"></script>
        <script>
            function handleApplication(applicationId, jobId, action) {
                let actionText = action === 'accept' ? "Accept" : "Reject";
                let url = action === 'accept' 
                            ? `/acept/${applicationId}/${jobId}` 
                            : `/reject/${applicationId}/${jobId}`;
    
                Swal.fire({
                    title: `Are you sure you want to ${actionText} this application?`,
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: action === 'accept' ? "#28a745" : "#dc3545",
                    cancelButtonColor: "#6c757d",
                    confirmButtonText: action === 'accept' ? "Yes, Accept it!" : "Yes, Reject it!",
                }).then((result) => {
                    if (result.isConfirmed) {
                        fetch(url, { method: "GET" })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire({
                                    title: `Application ${actionText}ed!`,
                                    icon: "success",
                                    timer: 2000,
                                    showConfirmButton: false
                                }).then(() => {
                                    location.reload(); // Refresh page after action
                                });
                            } else {
                                Swal.fire({
                                    title: "Error",
                                    text: data.message || "Something went wrong!",
                                    icon: "error"
                                });
                            }
                        }).catch(err => {
                            Swal.fire({
                                title: "Error",
                                text: "Failed to process request.",
                                icon: "error"
                            });
                        });
                    }
                });
            }
            function showFullAnswer(answer) {
        Swal.fire({
            title: "Application Objective",
            html: `<p style="text-align: left; font-size: 1rem; color: #333;">${answer}</p>`,
            confirmButtonText: "Close",
            confirmButtonColor: "#007bff"
        });
    }
        </script>
       
</body>

</html>