<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <title>Alumni Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/style.min.css" rel="stylesheet" />
    <link href="/styles/index.css" rel="stylesheet" />
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f6f9;
            margin: 0;
            padding: 0;
        }

        .container {
            max-width: 1200px;
            margin: 2rem auto;
            padding: 2rem;
            background-color: #ffffff;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        h2 {
            color: #333;
            margin-bottom: 1.5rem;
            font-size: 1.8rem;
            font-weight: 600;
            text-align: center;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 1rem;
            color: #333;
            margin-top: 1rem;
        }

        table th,
        table td {
            padding: 1rem;
            border: 1px solid #ddd;
        }

        table th {
            background-color: #007bff;
            color: #ffffff;
            text-align: left;
            font-weight: 600;
        }

        table tr:nth-child(even) {
            background-color: #f1f1f1;
        }

        table tr:hover {
            background-color: #e9ecef;
        }

        .table-actions {
            display: flex;
            gap: 0.5rem;
        }

        .btn-response {
            background-color: #28a745;
            color: #ffffff;
            border: none;
            padding: 0.5rem 1rem;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 500;
            transition: background-color 0.3s, box-shadow 0.3s;
        }

        .btn-response:hover {
            background-color: #218838;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .btn-response:focus {
            outline: none;
            box-shadow: 0 0 0 2px rgba(40, 167, 69, 0.5);
        }
    </style>
</head>

<body class="sb-nav-fixed">
    <%- include('../partials/Studentheader.ejs') %>
        <div id="layoutSidenav_content">
            <main>
                <div class="container-fluid px-4">
                    <div class="container">
                        <h2>Posted Jobs</h2>
                        <table>
                            <thead>
                                <tr>
                                    <th>Job Title</th>
                                    <th>Company</th>
                                    <th>Location</th>
                                    <th>Job Type</th>
                                    <th>Vacancy</th>
                                    <th>Apply</th>
                                </tr>
                            </thead>

                            <tbody id="applicationsTable">
                                <% job.forEach(element=> { %>
                                    <% if (element.current_status=='Accepted' ) { %>
                                        <tr data-id="<%= element.id %>">
                                            <td>
                                                <%= element.title %>
                                            </td>
                                            <td>
                                                <%= element.company_name %>
                                            </td>
                                            <td>
                                                <%= element.location %>
                                            </td>
                                            <td>
                                                <%= element.job_type %>
                                            </td>
                                            <td>
                                                <%= element.vacancy %>
                                            </td>
                                            <td>
                                                <button class="btn-response"
                                                    onclick="apply(this,'<%= element.email %>','')">Apply</button>
                                            </td>
                                        </tr>
                                        <% } %>
                                            <% }) %>
                            </tbody>

                        </table>
                    </div>
                </div>
            </main>
            <footer class="py-4 bg-light mt-auto">
                <div class="container-fluid px-4">
                    <div class="d-flex align-items-center justify-content-between small">
                        <div class="text-muted">Copyright &copy; Your Website 2023</div>
                        <div>
                            <a href="#">Privacy Policy</a>
                            &middot;
                            <a href="#">Terms &amp; Conditions</a>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"
            crossorigin="anonymous">
            </script>
        <script src="/js/scripts.js"></script>
        <!-- Tailwind CSS CDN -->
        <script src="https://cdn.tailwindcss.com"></script>

        <script>
            const apply = (ele, email, response) => {
                let row = ele.closest("tr");

                // Extract job details
                let jobId = row.getAttribute("data-id");
                let jobTitle = row.cells[0].innerText;
                let company = row.cells[1].innerText;
                let location = row.cells[2].innerText;
                let jobType = row.cells[3].innerText;
                let vacancy = row.cells[4].innerText;

                Swal.fire({
                    title: `Apply for ${jobTitle}`,
                    html: `
                        <div class="p-4">
                            <input type="hidden" id="jobId" name="jobId" value="${jobId}">
            
                            <div class="mb-3">
                                <label class="block text-left text-gray-700 font-medium mb-1">Availability for Interview</label>
                                <select id="availability" name="availability" class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" required>
                                    <option value="" disabled selected>Select</option>
                                    <option value="Any Time">Any Time</option>
                                    <option value="Morning">Morning</option>
                                    <option value="Afternoon">Afternoon</option>
                                    <option value="Evening">Evening</option>
                                </select>
                            </div>
            
                            <div class="mb-3">
                                <label class="block text-left text-gray-700 font-medium mb-1">Why You Want This Job</label>
                                <button onclick="generateAIResponse(event, '${jobTitle}', '${jobType}', '${company}')" class="block text-left text-blue-700 underline font-small mb-1 mt-2">Generate AI Response</button>
                              
                                <textarea id="jobDescription" name="answer" class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" rows="4" placeholder="Tell us why you want this job?" required></textarea>
                               
                            </div>
            
                            <div class="mb-3">
                                <label class="block text-left text-gray-700 font-medium mb-1">Upload Your Resume (PDF only)</label>
                                <input type="file" id="resume" name="resume" class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" accept=".pdf" required>
                            </div>
                        </div>
                    `,
                    showCancelButton: true,
                    confirmButtonText: "Submit Application",
                    cancelButtonText: "Cancel",
                    confirmButtonColor: "#22c55e",
                    cancelButtonColor: "#ef4444",
                    preConfirm: () => {
                        let availability = document.getElementById("availability").value;
                        let jobDescription = document.getElementById("jobDescription").value;
                        let resume = document.getElementById("resume").files[0];

                        if (!availability || !jobDescription || !resume) {
                            Swal.showValidationMessage("All fields are required!");
                            return false;
                        }

                        return { jobId, availability, jobDescription, resume };
                    }
                }).then(async (result) => {
                    if (result.isConfirmed) {
                        let formData = new FormData();
                        formData.append("jobId", result.value.jobId);
                        formData.append("availability", result.value.availability);
                        formData.append("answer", result.value.jobDescription);
                        formData.append("resume", result.value.resume);

                        const res = await fetch(`/apply?id=${jobId}&email=${email}`, {
                            method: "POST",
                            body: formData
                        })
                        const data = await res.json();
                        if (data.applied) {
                            Swal.fire({
                                icon: "error",
                                title: "Error",
                                text: "You have already applied for this job",
                                confirmButtonColor: "#ef4444"
                            });
                        }
                        if (data.success) {
                            Swal.fire({
                                icon: "success",
                                title: "Application Submitted!",
                                text: "Your job application has been sent successfully.",
                                confirmButtonColor: "#22c55e"
                            });
                        }
                        else {
                            Swal.fire({
                                icon: "error",
                                title: "Error",
                                text: data.message,
                                confirmButtonColor: "#ef4444"
                            });
                        }
                    }
                });
            };
            function generateAIResponse(event, title, type, company) {
                event.preventDefault(); // Prevent default behavior

                if (Swal.getPopup()) {
                    Swal.getPopup().classList.add('swal2-noanimation');
                }

                fetch('/generate', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ title, type, company })
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.response) {
                            let words = data.response.split(" ");
                            let displayedText = "";
                            let textArea = document.getElementById("jobDescription");

                            textArea.style.height = "150px"; // Increase the textarea size
                            textArea.style.overflowY = "auto"; // Add scrollbar if needed
                            textArea.value = ""; // Clear previous response

                            words.forEach((word, i) => {
                                setTimeout(() => {
                                    displayedText += word + " ";
                                    textArea.value = displayedText;
                                }, 50 * i);
                            });
                        } else {
                            Swal.fire({
                                icon: "error",
                                title: "Error",
                                text: "Failed to generate a response. Try again!",
                                confirmButtonColor: "#ef4444"
                            });
                        }
                    })
                    .catch(error => {
                        console.error("Error:", error);
                        Swal.fire({
                            icon: "error",
                            title: "Error",
                            text: "Something went wrong. Please try again.",
                            confirmButtonColor: "#ef4444"
                        });
                    });
            }

        </script>
</body>

</html>